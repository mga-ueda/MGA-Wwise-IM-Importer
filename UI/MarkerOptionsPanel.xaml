<UserControl x:Class="MgaWwiseIMImporter.UI.MarkerOptionsPanel"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MgaWwiseIMImporter.UI"
             Focusable="False"
             Background="{StaticResource PlaylistBackBrush}">
  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition x:Name="BodyRow" Height="Auto" />
    </Grid.RowDefinitions>

    <ui:SectionHeaderLabel x:Name="MoreOptionsHeader"
                           Grid.Row="0"
                           Height="{x:Static ui:DesignMetrics.SectionHeaderHeight}"
                           Padding="{x:Static ui:DesignMetrics.MarkerOptionsHeaderPadding}"
                           FontWeight="Bold"
                           FontSize="11.333"
                           Cursor="Hand"
                           MouseLeftButtonUp="MoreOptionsHeader_Click" />

    <Grid x:Name="BodyGrid" Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="280" />
        <ColumnDefinition Width="*" MinWidth="180" />
      </Grid.ColumnDefinitions>

      <!-- Row 1 left: Stream -->
      <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
        <ui:SectionHeaderLabel x:Name="StreamHeader"
                               Height="{x:Static ui:DesignMetrics.SectionHeaderHeight}"
                               Padding="{x:Static ui:DesignMetrics.MarkerOptionsHeaderPadding}"
                               FontWeight="Bold"
                               FontSize="11.333"
                               Text="Stream" />
        <ui:FlatOptionCheckBox x:Name="StreamEnabledCheckBox"
                               Margin="{x:Static ui:DesignMetrics.MarkerOptionsContentMargin}"
                               FontSize="11.333"
                               Height="{x:Static ui:DesignMetrics.FlatOptionRowHeight}"
                               Content="Stream"
                               Checked="StreamUiChanged"
                               Unchecked="StreamUiChanged" />
        <Grid Margin="{x:Static ui:DesignMetrics.MarkerOptionsContentMarginTop4}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="{x:Static ui:DesignMetrics.MarkerRowPitchGrid}" />
            <RowDefinition Height="{x:Static ui:DesignMetrics.MarkerRowPitchGrid}" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="PrefetchLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBox x:Name="PrefetchTextBox" Grid.Row="0" Grid.Column="1" Width="48" MaxLength="4"
                   Height="{x:Static ui:DesignMetrics.FlatOptionRowHeight}"
                   Padding="2,0" FontSize="11.333"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center"
                   TextChanged="StreamUiChanged" PreviewTextInput="StreamMsPreviewTextInput" />
          <TextBlock x:Name="PrefetchUnitLabel" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" />
          <TextBlock x:Name="LookAheadLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBox x:Name="LookAheadTextBox" Grid.Row="1" Grid.Column="1" Width="48" MaxLength="4"
                   Height="{x:Static ui:DesignMetrics.FlatOptionRowHeight}"
                   Padding="2,0" FontSize="11.333"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center"
                   TextChanged="StreamUiChanged" PreviewTextInput="StreamMsPreviewTextInput" />
          <TextBlock x:Name="LookAheadUnitLabel" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" />
        </Grid>
      </StackPanel>

      <!-- Row 1 right: Layer Music Option -->
      <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
        <ui:SectionHeaderLabel x:Name="LoudnessHeader"
                               Height="{x:Static ui:DesignMetrics.SectionHeaderHeight}"
                               Padding="{x:Static ui:DesignMetrics.MarkerOptionsHeaderPadding}"
                               FontWeight="Bold"
                               FontSize="11.333" />
        <ui:FlatOptionCheckBox x:Name="LoudnessGroupBalanceCheckBox"
                               Margin="{x:Static ui:DesignMetrics.MarkerOptionsContentMargin}"
                               FontSize="11.333"
                               Height="{x:Static ui:DesignMetrics.FlatOptionRowHeight}"
                               Checked="LoudnessUiChanged"
                               Unchecked="LoudnessUiChanged" />
      </StackPanel>

      <!-- Row 2 left: Marker Comment（帯は Digits + Prefix 列全体にまたがる・WinForms leftColW 相当） -->
      <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:SectionHeaderLabel x:Name="CommentHeader"
                               Grid.Row="0"
                               Height="{x:Static ui:DesignMetrics.SectionHeaderHeight}"
                               Padding="{x:Static ui:DesignMetrics.MarkerOptionsHeaderPadding}"
                               FontWeight="Bold"
                               FontSize="11.333" />
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" Margin="{x:Static ui:DesignMetrics.MarkerOptionsContentMargin}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="{x:Static ui:DesignMetrics.MarkerRowPitchGrid}" />
              <RowDefinition Height="{x:Static ui:DesignMetrics.MarkerRowPitchGrid}" />
              <RowDefinition Height="{x:Static ui:DesignMetrics.MarkerRowPitchGrid}" />
              <RowDefinition Height="{x:Static ui:DesignMetrics.MarkerRowPitchGrid}" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="DigitsLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="DigitsTextBox" Grid.Row="0" Grid.Column="1" Width="46" MaxLength="1"
                     Height="{x:Static ui:DesignMetrics.FlatOptionRowHeight}"
                     Padding="2,0" FontSize="11.333"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center"
                     TextChanged="MarkerUiChanged" PreviewTextInput="DigitsPreviewTextInput" />
            <!-- 親 Grid が既に S(12) インデント済み。WinForms 同様追加 Margin は付けない -->
            <ui:FlatOptionCheckBox x:Name="ZeroPadCheckBox"
                                   Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0"
                                   FontSize="11.333"
                                   Height="{x:Static ui:DesignMetrics.FlatOptionRowHeight}"
                                   Checked="MarkerUiChanged"
                                   Unchecked="MarkerUiChanged" />
            <ui:FlatOptionCheckBox x:Name="ResetPerPartCheckBox"
                                   Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Margin="0"
                                   FontSize="11.333"
                                   Height="{x:Static ui:DesignMetrics.FlatOptionRowHeight}"
                                   Checked="MarkerUiChanged"
                                   Unchecked="MarkerUiChanged" />
            <TextBlock x:Name="PreviewLabel" Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Grid>
          <!-- col3PadL = S(12)。帯下の Prefix 列 -->
          <Grid Grid.Column="1" Margin="{x:Static ui:DesignMetrics.MarkerOptionsContentMargin}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="{x:Static ui:DesignMetrics.MarkerRowPitchGrid}" />
              <RowDefinition Height="{x:Static ui:DesignMetrics.MarkerRowPitchGrid}" />
              <RowDefinition Height="{x:Static ui:DesignMetrics.MarkerRowPitchGrid}" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="PrefixLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="PrefixTextBox" Grid.Row="0" Grid.Column="1" Width="48"
                     Height="{x:Static ui:DesignMetrics.FlatOptionRowHeight}"
                     Padding="2,0" FontSize="11.333"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center" TextChanged="MarkerUiChanged" />
            <TextBlock x:Name="SuffixLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="SuffixTextBox" Grid.Row="1" Grid.Column="1" Width="48"
                     Height="{x:Static ui:DesignMetrics.FlatOptionRowHeight}"
                     Padding="2,0" FontSize="11.333"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center" TextChanged="MarkerUiChanged" />
            <TextBlock x:Name="JoinerLabel" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="JoinerTextBox" Grid.Row="2" Grid.Column="1" Width="48"
                     Height="{x:Static ui:DesignMetrics.FlatOptionRowHeight}"
                     Padding="2,0" FontSize="11.333"
                     VerticalContentAlignment="Center"
                     HorizontalContentAlignment="Center" TextChanged="MarkerUiChanged" />
          </Grid>
        </Grid>
      </Grid>

      <!-- Row 2 right: Marker Grid -->
      <StackPanel Grid.Row="1" Grid.Column="1">
        <ui:SectionHeaderLabel x:Name="GridHeader"
                               Height="{x:Static ui:DesignMetrics.SectionHeaderHeight}"
                               Padding="{x:Static ui:DesignMetrics.MarkerOptionsHeaderPadding}"
                               FontWeight="Bold"
                               FontSize="11.333" />
        <ui:FlatOptionRadioButton x:Name="GridBarRadio"
                                  GroupName="MarkerGrid"
                                  Margin="{x:Static ui:DesignMetrics.MarkerOptionsContentMargin}"
                                  Tag="Bar"
                                  FontSize="11.333"
                                  Height="{x:Static ui:DesignMetrics.FlatOptionRowHeight}"
                                  Checked="GridRadioChanged" />
        <ui:FlatOptionRadioButton x:Name="GridBeatRadio"
                                  GroupName="MarkerGrid"
                                  Margin="{x:Static ui:DesignMetrics.MarkerOptionsContentMargin}"
                                  Tag="Beat"
                                  FontSize="11.333"
                                  Height="{x:Static ui:DesignMetrics.FlatOptionRowHeight}"
                                  Checked="GridRadioChanged" />
        <ui:FlatOptionRadioButton x:Name="GridDefaultRadio"
                                  GroupName="MarkerGrid"
                                  Margin="{x:Static ui:DesignMetrics.MarkerOptionsContentMargin}"
                                  Tag="Default"
                                  FontSize="11.333"
                                  Height="{x:Static ui:DesignMetrics.FlatOptionRowHeight}"
                                  IsChecked="True"
                                  Checked="GridRadioChanged" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
