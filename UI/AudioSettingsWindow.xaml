<Window x:Class="MgaWwiseIMImporter.UI.AudioSettingsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MgaWwiseIMImporter.UI"
        xmlns:domain="clr-namespace:MgaWwiseIMImporter.Domain"
        WindowStyle="SingleBorderWindow"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackBrush}"
        Foreground="{StaticResource PrimaryForeBrush}"
        KeyDown="Window_KeyDown">
  <Border Padding="{x:Static ui:DesignMetrics.AudioPad}">
    <StackPanel x:Name="ContentRoot">
      <TextBlock Text="{x:Static domain:UiStrings.LabelAudioApi}"
                 Margin="0,0,0,3" />
      <ComboBox x:Name="ApiCombo"
                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                Padding="6,1"
                FontSize="11.333"
                VerticalContentAlignment="Center"
                Margin="0,0,0,12"
                SelectionChanged="ApiCombo_SelectionChanged" />

      <TextBlock Text="{x:Static domain:UiStrings.LabelAudioDevice}"
                 Margin="0,0,0,3" />
      <ComboBox x:Name="DeviceCombo"
                Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                Padding="6,1"
                FontSize="11.333"
                VerticalContentAlignment="Center"
                Margin="0,0,0,12" />

      <ui:SectionHeaderLabel x:Name="FadeDefaultsHeader"
                             Text="{x:Static domain:UiStrings.LabelFadeCurveDefaults}"
                             Height="{x:Static ui:DesignMetrics.MarkerHeaderHeight}"
                             Margin="{x:Static ui:DesignMetrics.AudioHeaderMargin}"
                             FontWeight="Bold"
                             FontSize="11.333" />

      <StackPanel x:Name="FadeRowsHost"
                  Margin="0,0,0,12" />

      <ui:SectionHeaderLabel x:Name="ExpectedFormatHeader"
                             Text="{x:Static domain:UiStrings.LabelExpectedWaveformFormat}"
                             Height="{x:Static ui:DesignMetrics.MarkerHeaderHeight}"
                             Margin="{x:Static ui:DesignMetrics.AudioHeaderMargin}"
                             FontWeight="Bold"
                             FontSize="11.333" />

      <Grid Margin="0,0,0,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="{x:Static ui:DesignMetrics.AudioInputHeightGrid}" />
          <RowDefinition Height="{x:Static ui:DesignMetrics.AudioInputHeightGrid}" />
          <RowDefinition Height="{x:Static ui:DesignMetrics.AudioInputHeightGrid}" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="{x:Static ui:DesignMetrics.AudioExpectedBoxWidthGrid}" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="ExpectedSampleRateLabel"
                   Grid.Row="0"
                   VerticalAlignment="Center"
                   Text="{x:Static domain:UiStrings.LabelExpectedSampleRateHz}" />
        <TextBox x:Name="ExpectedSampleRateTextBox"
                 Grid.Row="0"
                 Grid.Column="1"
                 Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                 MaxLength="6"
                 Padding="2,0"
                 FontSize="11.333"
                 VerticalContentAlignment="Center"
                 HorizontalContentAlignment="Center"
                 PreviewTextInput="ExpectedNumber_PreviewTextInput"
                 LostFocus="ExpectedNumber_LostFocus" />

        <TextBlock x:Name="ExpectedBitDepthLabel"
                   Grid.Row="1"
                   VerticalAlignment="Center"
                   Text="{x:Static domain:UiStrings.LabelExpectedBitDepth}" />
        <TextBox x:Name="ExpectedBitDepthTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                 MaxLength="2"
                 Padding="2,0"
                 FontSize="11.333"
                 VerticalContentAlignment="Center"
                 HorizontalContentAlignment="Center"
                 PreviewTextInput="ExpectedNumber_PreviewTextInput"
                 LostFocus="ExpectedNumber_LostFocus" />

        <TextBlock x:Name="ExpectedChannelsLabel"
                   Grid.Row="2"
                   VerticalAlignment="Center"
                   Text="{x:Static domain:UiStrings.LabelExpectedChannels}" />
        <TextBox x:Name="ExpectedChannelsTextBox"
                 Grid.Row="2"
                 Grid.Column="1"
                 Height="{x:Static ui:DesignMetrics.AudioInputHeight}"
                 MaxLength="2"
                 Padding="2,0"
                 FontSize="11.333"
                 VerticalContentAlignment="Center"
                 HorizontalContentAlignment="Center"
                 PreviewTextInput="ExpectedNumber_PreviewTextInput"
                 LostFocus="ExpectedNumber_LostFocus" />
      </Grid>

      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right">
        <ui:RoundedButton x:Name="OkButton"
                          Content="{x:Static domain:UiStrings.ButtonAudioSettingsOk}"
                          Width="{x:Static ui:DesignMetrics.AudioDialogButtonWidth}"
                          Height="{x:Static ui:DesignMetrics.AudioDialogButtonHeight}"
                          Margin="0,0,12,0"
                          CornerRadius="6"
                          FontWeight="Bold"
                          FontSize="12"
                          IsDefault="True"
                          Click="OkButton_Click" />
        <ui:RoundedButton x:Name="CancelButton"
                          Content="{x:Static domain:UiStrings.ButtonAudioSettingsCancel}"
                          Width="{x:Static ui:DesignMetrics.AudioDialogButtonWidth}"
                          Height="{x:Static ui:DesignMetrics.AudioDialogButtonHeight}"
                          CornerRadius="6"
                          FontWeight="Bold"
                          FontSize="12"
                          IsCancel="True"
                          Click="CancelButton_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
