<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>MgaWwiseIMImporter.Program</StartupObject>
    <RootNamespace>MgaWwiseIMImporter</RootNamespace>
    <AssemblyName>MGA Wwise IM Importer</AssemblyName>
    <Product>MGA Wwise IM Importer</Product>
    <ApplicationTitle>MGA Wwise IM Importer</ApplicationTitle>
    <ApplicationIcon>Assets\Branding\MgaWwiseIMImporter.ico</ApplicationIcon>
    <Version>1.1.7-beta</Version>
    <AssemblyVersion>1.1.7.0</AssemblyVersion>
    <FileVersion>1.1.7.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Utf8Output>true</Utf8Output>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);MgaWwiseIMImporter.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MgaWwiseIMImporter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AppVersion</_Parameter1>
      <_Parameter2>$(Version)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- 色調整パネルは開発ビルド専用。Release バイナリには含めない。 -->
    <Compile Remove="UI\ColorDevPanelWindow.xaml.cs" Condition="'$(Configuration)' == 'Release'" />
    <Page Remove="UI\ColorDevPanelWindow.xaml" Condition="'$(Configuration)' == 'Release'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Branding\MiyabiGameAudio.png">
      <LogicalName>MgaWwiseIMImporter.Branding.MiyabiGameAudio.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\Branding\MgaWwiseIMImporter.ico">
      <LogicalName>MgaWwiseIMImporter.Branding.MgaWwiseIMImporter.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\Fonts\UDEVGothic-Regular.ttf">
      <LogicalName>MgaWwiseIMImporter.Fonts.UDEVGothic-Regular.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\Wave\High.wav">
      <LogicalName>MgaWwiseIMImporter.Wave.High.wav</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\Wave\Low.wav">
      <LogicalName>MgaWwiseIMImporter.Wave.Low.wav</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\Fonts\LICENSE-UDEV-GOTHIC.txt">
      <LogicalName>MgaWwiseIMImporter.Fonts.LICENSE-UDEV-GOTHIC.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\UDEVGothic-Regular.ttf" />
    <Resource Include="Assets\Branding\MiyabiGameAudio.png" />
    <Resource Include="Assets\Branding\MgaWwiseIMImporter.ico" />
  </ItemGroup>

</Project>
